#!/bin/bash
# Serialize access to a named resource using a lock file.
#
# Usage:
#   work_queue queue <name>   Wait until <name> is free, then take the lock.
#   work_queue clear <name>   Release the lock held for <name>.
#
# The lock is a file at "${HOME}/.wqcache/<name>". A caller that finds the file present waits
# for the holder to release it. This is a best-effort coordination helper for build steps; it
# does not detect a stale lock left behind by a crashed process.
set -euo pipefail

COMMAND="${1:-}"
QUEUE="${2:-}"
CACHE_FOLDER="${HOME}/.wqcache"
CACHE_FILE="${CACHE_FOLDER}/${QUEUE}"

if [ "${COMMAND}" = "queue" ]; then
    mkdir -p "${CACHE_FOLDER}"
    while [ -f "${CACHE_FILE}" ]; do
        echo "waiting for ${QUEUE}"
        sleep 10
    done
    touch "${CACHE_FILE}"
    exit 0
fi

if [ "${COMMAND}" = "clear" ]; then
    mkdir -p "${CACHE_FOLDER}"
    if [ -f "${CACHE_FILE}" ]; then
        rm -fR "${CACHE_FILE}"
    fi
    exit 0
fi

echo "Invalid command [${COMMAND}] [${QUEUE}]"
exit 1
