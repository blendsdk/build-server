# Host configuration template for the runner fleet.
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must never be
# committed.

# GitHub token used to mint runner registration tokens for every organization in orgs.conf.
# Recommended: a classic PAT with the admin:org scope; authorize it for each org that uses
# SAML SSO. A fine-grained token ("Self-hosted runners: Read and write") works for one org only.
# Guide: https://blendsdk.github.io/build-server/guide/github-token
ACCESS_TOKEN=

# Credentials for the co-located registry; the same pair seeds registry/auth/registry.password
# and is injected into runners so jobs can docker push.
REGISTRY_USER=ci
REGISTRY_PASS=

# Shared secret for the co-located Docker registry service.
REGISTRY_HTTP_SECRET=

# Address jobs use to reach the registry inside the fleet (service name:port).
REGISTRY_ADDR=registry:5000

# Registries the inner Docker daemon treats as insecure (plain HTTP). Defaults to the
# co-located registry; set to empty to disable.
INSECURE_REGISTRIES=registry:5000

# Optional: force the inner daemon's storage driver (for example vfs on hosts that cannot run
# containers with the default overlay driver). Leave empty for automatic detection and fallback.
DOCKERD_STORAGE_DRIVER=

# Host port for the private registry (default 5000). Runners reach the registry as
# registry:5000 inside the fleet; change this only for outside consumers or when the
# port is already taken. bootstrap.sh picks a free port automatically on a fresh install.
REGISTRY_PORT=5000

# Optional: domain used for the runner's git identity email
# (default: users.noreply.github.com).
RUNNER_EMAIL_DOMAIN=
