# Host configuration template for the runner fleet.
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must never be
# committed.

# GitHub token used to mint runner registration tokens for every organization in orgs.conf.
# Recommended: a classic PAT with the admin:org scope; authorize it for each org that uses
# SAML SSO. A fine-grained token ("Self-hosted runners: Read and write") works for one org only.
# Guide: https://blendsdk.github.io/build-server/guide/github-token
ACCESS_TOKEN=

# Shared secret for the co-located Docker registry service.
REGISTRY_HTTP_SECRET=

# Optional: domain used for the runner's git identity email
# (default: users.noreply.github.com).
RUNNER_EMAIL_DOMAIN=
